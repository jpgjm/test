+/// A. ゲスト自身の Metadata.appintents から読む。
+static id LCBLoadGuestActionMetadata(NSString *identifier) {
+    NSBundle *main = NSBundle.mainBundle;
+    return LCBLoadActionMetadata(main.bundleURL, main.bundleIdentifier, identifier);
+}
