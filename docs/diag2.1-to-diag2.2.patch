+/// 元の LNAction に metadata を付けた複製を作る。
+/// `-[LNAction actionWithParameters:]` と同じ初期化メソッド (23G83 で確認) を使う。
+static id LCBActionWithMetadata(id action, id metadata) {
+    SEL init = NSSelectorFromString(@"_initWithIdentifier:mangledTypeName:openAppWhenRun:explicitAuthenticationPolicy:outputFlags:outputType:systemProtocols:parameters:metadata:");
+    Class actionClass = NSClassFromString(@"LNAction");
+    if (![actionClass instancesRespondToSelector:init]) {
